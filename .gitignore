# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

api/config/config.php
api/vendor

# One-time bulk-import data (real artist names/emails) — not source code, never committed
api/scripts/*.json
api/scripts/EXCLUDED_shared_email.md

api/storage/covers/*
api/storage/audio/*
!api/storage/covers/.gitkeep
!api/storage/audio/.gitkeep
!api/storage/audio/.htaccess

api/storage/productions/covers/*
api/storage/productions/audio/*
api/storage/beats/audio/*
!api/storage/productions/covers/.gitkeep
!api/storage/productions/audio/.gitkeep
!api/storage/beats/audio/.gitkeep

# The initial seed images (migrated from the old hardcoded Spotlight page
# content) are force-added and tracked despite this rule — this only keeps
# *future* admin-uploaded spotlight images out of git, same as productions/beats.
api/storage/spotlight/items/*
api/storage/spotlight/artist-of-month.*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
